-  readonly property string icon: Model.connectionIcon(kind, signalStrength)
+  // portal-pop: NetworkManager connectivity ("full" | "portal" | "limited" | "none" | "unknown").
+  // Quickshell.Networking doesn't expose it, so poll nmcli slowly while on wifi.
+  property string connectivity: "full"
+  readonly property bool portalDetected: kind === "wifi" && connectivity === "portal"
+  onConnectedWifiNetworkChanged: connectivityRecheck.restart()
+
+  Process {
+    id: connectivityProc
+    // NM alone misses some portals (Starbucks reports "full" while blocked),
+    // so when it says full, confirm with one tiny http probe.
+    command: ["bash", "-c",
+      "[ -e /tmp/portal-test ] && { echo portal; exit; }; " +
+      "c=$(nmcli -g CONNECTIVITY general 2>/dev/null); " +
+      "if [ \"$c\" = full ]; then " +
+      "r=$(curl -s -m 4 -o /dev/null -w '%{http_code} %{redirect_url}' http://ping.archlinux.org); " +
+      "case \"$r\" in '200 ') echo full;; '000 ') echo none;; *) echo portal;; esac; " +
+      "else echo \"${c:-unknown}\"; fi"]
+    stdout: StdioCollector {
+      waitForEnd: true
+      onStreamFinished: root.connectivity = String(text).trim() || "unknown"
+    }
+  }
+  // Event-driven, no idle polling (phones probe on connect, not forever):
+  // - burst after a wifi connection comes up (NM needs a few seconds to settle)
+  // - once each time the panel is opened
+  // - every 20s after the user opens the portal, until we're online
+  Timer {
+    id: connectivityRecheck
+    interval: 3000
+    repeat: false
+    onTriggered: { if (!connectivityProc.running) connectivityProc.running = true; connectBurst.restart() }
+  }
+  Timer {
+    id: connectBurst
+    property int step: 0
+    interval: 7000
+    repeat: true
+    onRunningChanged: if (running) step = 0
+    onTriggered: {
+      step += 1
+      if (!connectivityProc.running) connectivityProc.running = true
+      if (step >= 2) stop()   // 3s, 10s, 17s after connect — then quiet
+    }
+  }
+  function openPortal() {
+    Quickshell.execDetached(["bash", "-c", Model.openPortalScript])
+    portalRecheck.start()
+  }
+  Timer {
+    id: portalRecheck
+    interval: 20000
+    repeat: true
+    // Ask NM to re-probe while the user signs in; stops once we're online.
+    running: false
+    onTriggered: {
+      if (!root.portalDetected) { stop(); return }
+      Quickshell.execDetached(["nmcli", "networking", "connectivity", "check"])
+      connectivityRecheck.restart()
+    }
+  }
+
+  readonly property string icon: Model.connectionIcon(kind, signalStrength, connectivity)
 
